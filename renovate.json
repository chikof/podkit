{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^agent/src/ingress\\.rs$/"],
			"matchStrings": ["\"docker\\.io/library/traefik:(?<currentValue>v[0-9.]+)\""],
			"depNameTemplate": "traefik",
			"datasourceTemplate": "docker"
		}
	],
	"packageRules": [
		{
			"description": "SvelteKit and svelte-check need the TypeScript 6 JS API; svelte-check runs TS 7 from the @typescript/native alias",
			"matchManagers": ["bun"],
			"matchDepNames": ["typescript"],
			"allowedVersions": "<7"
		}
	]
}
