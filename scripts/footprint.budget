# Budgets, in KB, read by scripts/footprint.sh --check. docs/footprint.md has the history.
#
# Idle RSS: only the cap, the promise (server 60 MB, agent 25 MB). It has no baseline: most of
# it is the binary's own code, mapped, and the resident share moves with the layout of the
# binary. The crate split (c0bf36d) took the server from 16.0 MB to 22.6 MB that way with no
# new code (docs/footprint.md, "The crate split").
server_cap_kb=61440
agent_cap_kb=25600
# What a process may add to its cap for a moment (peak RSS, VmHWM). The server hashes a
# password with 64 MiB of memory (Argon2id, crates/crypto/src/argon2.rs), one hash at a
# time, and frees it. The agent has nothing of the kind.
server_transient_kb=65536
agent_transient_kb=0
# File-backed idle RSS of the server (idle RSS minus RssAnon): the code of the binary that
# is mapped. scripts/build-ordered.sh keeps it small by laying the start-up code out in one
# block; without that it is about 19 MB. Fails over baseline + 20 %. When it does, a list
# of start-up functions has gone stale: run scripts/startup-order.sh. Measured: 9.2 MB here,
# 9.7 MB on CI.
server_idle_file_baseline_kb=10240
# Anonymous idle RSS (RssAnon: heap and stacks), the memory a process holds. Fails over
# baseline + 20 %. The baseline is the last measured value, rounded up; raise it only with a
# reason. Measured: server 3952 KB, agent 1092 KB. The agent's is small enough for
# allocator noise to matter, so its baseline has more room.
server_anon_baseline_kb=4096
agent_anon_baseline_kb=1280
# The same after the load pass (sign-up, sign-in, every linked page, the API lists).
# The server has downloaded the template catalog by then (`--catalog`), and holds it: 487
# templates parsed, with their logos (4.1 MB of the files). Measured: server 13.2 MB with
# the catalog and 5.2 MB without; agent 1.2 MB.
server_used_anon_baseline_kb=14336
agent_used_anon_baseline_kb=1280
# Binary size, which follows code and dependencies. Fails over baseline + 10 %.
# Measured: server 23528 KB (28960 KB while the templates were compiled in), agent 7872 KB.
server_bin_baseline_kb=23808
agent_bin_baseline_kb=7936
# The shared libraries a binary may ask for (stems, globs allowed). Anything else is a new
# native dependency: OpenSSL arriving with webauthn-rs 0.5 cost 3 MB (docs/footprint.md, "Wave B").
allowed_libs="libc libm libgcc_s ld-linux-*"
