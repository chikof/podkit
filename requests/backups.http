### CreateTarget
# @name CreateTarget
# @capture file-secret backup_target.id = response.json.id
# note: any S3-compatible bucket. endpoint must be https (http is only
# accepted for localhost, 127.0.0.1 and ::1) and carry no credentials.
# path_style true addresses the bucket as endpoint/bucket (MinIO, Garage);
# false uses bucket.endpoint, which cannot work on an IP address. prefix is
# optional; objects are stored as
# {prefix}/{team id}/databases/{database id}/{backup id}.{sql.gz|archive.gz}.
# The secret is stored encrypted and never returned. 409 when the team
# already has a target with that name.
POST {{base.url}}/teams/{{team.id}}/backup-targets
Authorization: Bearer {{auth.token}}
Content-Type: application/json

{
  "name": "minio",
  "endpoint": "http://localhost:9000",
  "region": "us-east-1",
  "bucket": "podkit-backups",
  "path_style": true,
  "prefix": "prod",
  "access_key_id": "REPLACE_ME",
  "secret_access_key": "REPLACE_ME"
}

### ListTargets
# @name ListTargets
GET {{base.url}}/teams/{{team.id}}/backup-targets
Authorization: Bearer {{auth.token}}

### DeleteTarget
# @name DeleteTarget
# note: databases using this target lose it (their schedule stops firing)
# and existing backups can no longer be restored or deleted from storage.
DELETE {{base.url}}/teams/{{team.id}}/backup-targets/{{backup_target.id}}
Authorization: Bearer {{auth.token}}

### Backup
# @name Backup
# @capture file-secret backup.id = response.json.id
# note: needs databases.http Settings to have set backup_target_id first
# (400 "configure a backup target first"); redis is not supported (400).
# Returns 202 with status `queued`. Poll List for `succeeded` or `failed`
# (read error). Scheduled backups appear in the same list with
# triggered_by null.
POST {{base.url}}/teams/{{team.id}}/projects/{{project.id}}/databases/{{database.id}}/backups
Authorization: Bearer {{auth.token}}

### List
# @name List
# note: newest first. ?limit= takes 1-200 (default 50); ?before=<backup id>
# returns the next page.
GET {{base.url}}/teams/{{team.id}}/projects/{{project.id}}/databases/{{database.id}}/backups
Authorization: Bearer {{auth.token}}

### Restore
# @name Restore
# note: replaces the database's contents with this dump. The backup must be
# `succeeded` and the database `running` (400 otherwise). Returns 202;
# a failure shows up as `restore failed: ...` in the database's
# status_message.
POST {{base.url}}/teams/{{team.id}}/projects/{{project.id}}/databases/{{database.id}}/backups/{{backup.id}}/restore
Authorization: Bearer {{auth.token}}

### Delete
# @name Delete
# note: removes the object from the bucket, then the row. 409 while the
# backup is still queued or running.
DELETE {{base.url}}/teams/{{team.id}}/projects/{{project.id}}/databases/{{database.id}}/backups/{{backup.id}}
Authorization: Bearer {{auth.token}}
