### Deploy via webhook secret (header)
# @name DeployHeader
# secret comes from applications.http Create response (webhook_secret,
# only ever shown once).
POST {{base.url}}/webhooks/deploy/{{application.id}}
X-Webhook-Secret: {{application.webhook_secret}}

### Deploy via GitLab token header
# @name DeployGitlab
POST {{base.url}}/webhooks/deploy/{{application.id}}
X-Gitlab-Token: {{application.webhook_secret}}

### GitHub ping (ignored; GitHub signs the body with X-Hub-Signature-256)
# @name GithubPing
POST {{base.url}}/webhooks/deploy/{{application.id}}
X-GitHub-Event: ping
X-Webhook-Secret: {{application.webhook_secret}}
Content-Type: application/json

{}
