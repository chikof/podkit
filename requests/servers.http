### List
# @name List
# note: the team's `local` server is auto-provisioned when the team is
# created (see team.http Create) — no request needed to get one.
GET {{base.url}}/api/v1/teams/{{team.id}}/servers
Authorization: Bearer {{auth.token}}

### Create remote
# @name Create
# note: returns 202 with status `pending`; a bootstrap job installs the agent.
# Poll List until status is `active` (read status_message on failure).
# @capture file-secret server.id = response.json.id
POST {{base.url}}/api/v1/teams/{{team.id}}/servers
Authorization: Bearer {{auth.token}}
Content-Type: application/json

{
  "name": "remote-1",
  "hostname": "10.0.0.5",
  "ssh_user": "deploy",
  "ssh_private_key": "-----BEGIN OPENSSH PRIVATE KEY-----\nfakefakefake\n-----END OPENSSH PRIVATE KEY-----"
}

### Bootstrap (reinstall / upgrade the agent)
# @name Bootstrap
# note: add ?reset_host_key=true after reinstalling the host to re-pin its ssh
# host key; compare host_key_fingerprint with `ssh-keygen -lf` first.
POST {{base.url}}/api/v1/teams/{{team.id}}/servers/{{server.id}}/bootstrap
Authorization: Bearer {{auth.token}}

### Delete
# @name Delete
DELETE {{base.url}}/api/v1/teams/{{team.id}}/servers/{{server.id}}
Authorization: Bearer {{auth.token}}
