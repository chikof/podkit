  "query": "\n\t\t\tSELECT id AS \"id!: BackupId\", COALESCE(finished_at, created_at) AS \"taken_at!\",\n\t\t\t\tsource_tables\n\t\t\tFROM backups\n\t\t\tWHERE database_id = $1 AND status = 'succeeded'\n\t\t\t\tAND object_key IS NOT NULL AND target_id IS NOT NULL\n\t\t\tORDER BY id DESC\n\t\t\tLIMIT 1\n\t\t",
