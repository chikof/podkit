  "query": "\n\t\t\tSELECT s.id AS \"id: ServerId\", s.scan_enabled,\n\t\t\t\tCOUNT(i.id) FILTER (WHERE i.db_built IS NOT NULL) AS \"scanned!\"\n\t\t\tFROM servers s LEFT JOIN image_scans i ON i.server_id = s.id\n\t\t\tWHERE s.team_id = $1\n\t\t\tGROUP BY s.id\n\t\t",
