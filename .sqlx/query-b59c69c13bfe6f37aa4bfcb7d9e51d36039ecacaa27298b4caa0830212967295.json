  "query": "\n\t\t\t\tSELECT e.id AS \"id: EnvironmentId\", e.name,\n\t\t\t\t\tp.id AS \"project_id: ProjectId\", p.name AS project_name\n\t\t\t\tFROM environments e\n\t\t\t\tJOIN projects p ON p.id = e.project_id\n\t\t\t\tWHERE p.team_id = $1 AND e.name ILIKE $2\n\t\t\t\tORDER BY e.name, e.id\n\t\t\t\tLIMIT $3\n\t\t\t",
