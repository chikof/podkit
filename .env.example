DATABASE_URL = "postgres://postgres:postgres@localhost:5432/postgres"
JWT_SECRET = "SecureScret"
AGE_SECRET_KEY = "AGE-SECRET-KEY-1..."
# optional - override if binding :80/:443 requires privileges you don't
# have (common for rootless podman without CAP_NET_BIND_SERVICE)
INGRESS_PORT = 80
HTTPS_PORT = 443
# optional - omit to disable custom-domain HTTPS entirely
ACME_EMAIL = "you@example.com"
# optional - comma-separated browser origins allowed by CORS; defaults to
# the SvelteKit dev/preview servers (http://localhost:5173,4173)
DASHBOARD_ORIGINS = "http://localhost:5173,http://localhost:4173"
