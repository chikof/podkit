DATABASE_URL = "postgres://postgres:postgres@localhost:5432/postgres"
AGE_SECRET_KEY = "AGE-SECRET-KEY-1..."
# who may sign up: "first-user" (default; only the first account, which becomes
# the admin - right for a homelab), "open" (anyone - set this for a hosted
# instance) or "closed" (nobody; add people with an account that exists)
REGISTRATION = "first-user"
# optional - override if binding :80/:443 requires privileges you don't
# have (common for rootless podman without CAP_NET_BIND_SERVICE)
INGRESS_PORT = 80
HTTPS_PORT = 443
# optional - omit to disable custom-domain HTTPS entirely
ACME_EMAIL = "you@example.com"
# optional - control-plane state (job build logs); default ~/.local/share/podkit
DATA_DIR = "/var/lib/podkit"
# optional - unix socket of the local server's podkit-agent; default ~/.podkit/agent.sock
LOCAL_AGENT_SOCKET = "/run/podkit/agent.sock"
# optional - directory holding podkit-agent[-{arch}] binaries for remote bootstrap;
# default is the directory of the server executable
AGENT_BINARIES_DIR = "/usr/lib/podkit/agents"
